DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# An existing User.id in the KiguDB database, used for both audit fields.
IMPORT_USER_ID=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional if using temporary AWS credentials:
AWS_SESSION_TOKEN=
S3_BUCKET=kigu-db
S3_PUBLIC_BASE_URL=
FEISHU_SHARE_URL=
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# Groq translates Discord listing descriptions into English.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
